    "preference": ["id", "text", "path"],
    "notes": [
      "The bridge resolves id/text selectors to the nearest clickable ancestor for click and long-click.",
      "Use an exact text selector only when it is unique in the current tree; inspect first after opening a modal or page.",
      "Paths are capture-specific. Re-inspect before using a path, especially after returning Home or changing scroll position.",
      "The bridge never retries an action automatically. Preserve action IDs and inspect after an uncertain result."
    ]
  },
  "actions": {
    "inspect": "Read visible nodes and their ids, labels, bounds, flags and action ids.",
    "act": "Dispatch one semantic action: click, long-click, set-text, scroll-forward, scroll-backward, focus, select or back.",
